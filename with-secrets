#!/usr/bin/env python3
"""with-secrets NAME [NAME...] -- COMMAND...

Run one command with secrets from the secrets page as environment variables.
They exist only for that command, and their values are replaced by *** in
what it prints."""
import os
import subprocess
import sys
from pathlib import Path

SECRETS = Path(os.environ.get("SECRETS_DIR", "/run/agent-secrets"))

args = sys.argv[1:]
if "--" not in args:
    sys.exit(__doc__)
names, command = args[:args.index("--")], args[args.index("--") + 1:]
env, values = dict(os.environ), []
for name in names:
    if not (SECRETS / name).is_file():
        sys.exit(f"with-secrets: there's no secret called {name}. Ask the person to add it.")
    env[name] = (SECRETS / name).read_text().strip()
    values.append(env[name])

process = subprocess.Popen(command, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
for line in process.stdout:
    for value in values:
        line = line.replace(value, "***")
    sys.stdout.write(line)
sys.exit(process.wait())
